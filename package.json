{
  "name": "awesome-chilean-rss",
  "version": "1.0.0",
  "description": "Validador de feeds RSS/Atom de sitios chilenos",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "validate": "node scripts/core/validate_feeds.js",
    "generate": "node scripts/core/generate.js",
    "validate:json": "node scripts/validation/validate-json.js",
    "validate:opml": "node scripts/validation/validate-opml.js",
    "check:docs": "node scripts/validation/check-docs-sync.js",
    "validate:watchlist": "node scripts/core/validate-watchlist.js",
    "fix:stale": "node scripts/utils/fix-stale-feeds.js",
    "check:overlap": "node scripts/utils/check-feed-overlap.js",
    "check:duplicates": "node scripts/utils/find-duplicates.js",
    "discover:categories": "node scripts/utils/discover-category-feeds.js",
    "sync:subfeeds": "node scripts/utils/add-site-subfeeds.js",
    "standardize:keys": "node scripts/utils/standardize-feed-keys.js",
    "verify:feeds": "node scripts/utils/verify-feeds.js",
    "install:browser": "playwright install chromium",
    "lint": "eslint .",
    "check:sync": "pnpm run validate:json && pnpm run check:duplicates && pnpm run check:docs && pnpm run validate:opml && pnpm run generate && git diff --exit-code dist README.md"
  },
  "dependencies": {
    "fast-xml-parser": "5.8.0"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "author": {
    "name": "Alplox",
    "url": "https://github.com/alplox"
  },
  "engines": {
    "node": ">=18.13.0"
  },
  "license": "CC0-1.0",
  "devDependencies": {
    "eslint": "^10.5.0",
    "globals": "^17.6.0"
  }
}
